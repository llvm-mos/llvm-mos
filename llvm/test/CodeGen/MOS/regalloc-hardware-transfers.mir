# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mos -mcpu=mos6502 -run-pass=mos-regalloc -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=CHECK,BASE
# RUN: llc -mtriple=mos -mcpu=mos65c02 -run-pass=mos-regalloc -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=CHECK,BASE
# RUN: llc -mtriple=mos -mcpu=mosw65816 -run-pass=mos-regalloc -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=CHECK,BASE
# RUN: llc -mtriple=mos -mcpu=moshuc6280 -run-pass=mos-regalloc -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=CHECK,BASE
# RUN: llc -mtriple=mos -mcpu=mosspc700 -run-pass=mos-regalloc -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=CHECK,SPC

# Every processor reaches any allocation using the same transfers: stores to
# imaginary storage, reloads from it, and flag copies to and from byte LSBs.
# SPC700 can also load an immediate directly into imaginary storage.

# Pin X and Y so preserving the live value across the second definition in A
# requires an imaginary save. CMPImm requires a hardware input, so it then
# needs a reload.
---
name: save_and_reload
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr, assigned-phys: '$rc2' }
  - { id: 1, class: gpr, assigned-phys: '$rc3' }
  - { id: 2, class: cc, assigned-phys: '$rc4lsb' }
  - { id: 3, class: cc, assigned-phys: '$rc4lsb' }
body: |
  bb.0:
    liveins: $x, $y
    ; BASE-LABEL: name: save_and_reload
    ; BASE: liveins: $x, $y
    ; BASE-NEXT: {{  $}}
    ; BASE-NEXT: $a = LDImm 1
    ; BASE-NEXT: $rc2 = COPY killed $a
    ; BASE-NEXT: $a = LDImm 9
    ; BASE-NEXT: dead $c = CMPImm killed $a, 1
    ; BASE-NEXT: $a = COPY killed $rc2
    ; BASE-NEXT: dead $c = CMPImm killed $a, 2
    ; BASE-NEXT: RTS implicit killed $x, implicit killed $y
    ;
    ; SPC-LABEL: name: save_and_reload
    ; SPC: liveins: $x, $y
    ; SPC-NEXT: {{  $}}
    ; SPC-NEXT: $rc2 = LDImm 1
    ; SPC-NEXT: $a = LDImm 9
    ; SPC-NEXT: dead $c = CMPImm killed $a, 1
    ; SPC-NEXT: $a = COPY killed $rc2
    ; SPC-NEXT: dead $c = CMPImm killed $a, 2
    ; SPC-NEXT: RTS implicit killed $x, implicit killed $y
    %0:gpr = LDImm 1
    %1:gpr = LDImm 9
    %2:cc = CMPImm %1, 1
    %3:cc = CMPImm %0, 2
    RTS implicit $x, implicit $y
...

# Reloading does not invalidate the imaginary copy. Reuse that copy through a
# second clobber without saving the value a second time.
---
name: reuse_saved_value
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr, assigned-phys: '$rc2' }
  - { id: 1, class: gpr, assigned-phys: '$rc3' }
  - { id: 2, class: cc, assigned-phys: '$rc4lsb' }
  - { id: 3, class: cc, assigned-phys: '$rc4lsb' }
  - { id: 4, class: gpr, assigned-phys: '$rc3' }
  - { id: 5, class: cc, assigned-phys: '$rc4lsb' }
  - { id: 6, class: cc, assigned-phys: '$rc4lsb' }
body: |
  bb.0:
    liveins: $x, $y
    ; BASE-LABEL: name: reuse_saved_value
    ; BASE: liveins: $x, $y
    ; BASE-NEXT: {{  $}}
    ; BASE-NEXT: $a = LDImm 1
    ; BASE-NEXT: $rc2 = COPY killed $a
    ; BASE-NEXT: $a = LDImm 9
    ; BASE-NEXT: dead $c = CMPImm killed $a, 1
    ; BASE-NEXT: $a = COPY $rc2
    ; BASE-NEXT: dead $c = CMPImm killed $a, 2
    ; BASE-NEXT: $a = LDImm 8
    ; BASE-NEXT: dead $c = CMPImm killed $a, 3
    ; BASE-NEXT: $a = COPY killed $rc2
    ; BASE-NEXT: dead $c = CMPImm killed $a, 3
    ; BASE-NEXT: RTS implicit killed $x, implicit killed $y
    ;
    ; SPC-LABEL: name: reuse_saved_value
    ; SPC: liveins: $x, $y
    ; SPC-NEXT: {{  $}}
    ; SPC-NEXT: $rc2 = LDImm 1
    ; SPC-NEXT: $a = LDImm 9
    ; SPC-NEXT: dead $c = CMPImm killed $a, 1
    ; SPC-NEXT: $a = COPY $rc2
    ; SPC-NEXT: dead $c = CMPImm killed $a, 2
    ; SPC-NEXT: $a = LDImm 8
    ; SPC-NEXT: dead $c = CMPImm killed $a, 3
    ; SPC-NEXT: $a = COPY killed $rc2
    ; SPC-NEXT: dead $c = CMPImm killed $a, 3
    ; SPC-NEXT: RTS implicit killed $x, implicit killed $y
    %0:gpr = LDImm 1
    %1:gpr = LDImm 9
    %2:cc = CMPImm %1, 1
    %3:cc = CMPImm %0, 2
    %4:gpr = LDImm 8
    %5:cc = CMPImm %4, 3
    %6:cc = CMPImm %0, 3
    RTS implicit $x, implicit $y
...

# Keep the carry value through a second comparison that overwrites C. Moving
# it out of C requires a flag copy into a byte's LSB.
---
name: preserve_carry
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr, assigned-phys: '$rc2' }
  - { id: 1, class: cc, assigned-phys: '$rc3lsb' }
  - { id: 2, class: gpr, assigned-phys: '$rc4' }
  - { id: 3, class: cc, assigned-phys: '$rc5lsb' }
  - { id: 4, class: anyi1, assigned-phys: '$rc6lsb' }
body: |
  bb.0:
    ; CHECK-LABEL: name: preserve_carry
    ; CHECK: $a = LDImm 1
    ; CHECK-NEXT: $c = CMPImm killed $a, 2
    ; CHECK-NEXT: $a = LDImm 3
    ; CHECK-NEXT: $xlsb = COPY killed $c
    ; CHECK-NEXT: dead $c = CMPImm killed $a, 3
    ; CHECK-NEXT: dead $xlsb = COPY killed $xlsb
    %0:gpr = LDImm 1
    %1:cc = CMPImm %0, 2
    %2:gpr = LDImm 3
    %3:cc = CMPImm %2, 3
    %4:anyi1 = COPY %1
...

# Likewise, keep an overflow value through a second definition of V.
---
name: preserve_overflow
tracksRegLiveness: true
registers:
  - { id: 0, class: vc, assigned-phys: '$rc2lsb' }
  - { id: 1, class: vc, assigned-phys: '$rc3lsb' }
  - { id: 2, class: anyi1, assigned-phys: '$rc4lsb' }
body: |
  bb.0:
    ; CHECK-LABEL: name: preserve_overflow
    ; CHECK: $v = CLV
    ; CHECK-NEXT: $alsb = COPY killed $v
    ; CHECK-NEXT: dead $v = CLV
    ; CHECK-NEXT: dead $alsb = COPY killed $alsb
    %0:vc = CLV
    %1:vc = CLV
    %2:anyi1 = COPY %0
...
