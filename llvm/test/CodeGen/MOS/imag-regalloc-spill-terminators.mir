# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mos -mattr=+static-stack -stress-regalloc=6 -run-pass=mos-imag-reg-spill -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=STATIC
# RUN: llc -mtriple=mos -mattr=-static-stack -stress-regalloc=3 -run-pass=mos-imag-reg-spill -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=SOFT

# Extra loads force a return input to spill. Their temporaries die before
# the terminators, leaving room to reload both inputs before either return.
# Multiple returns with implicit virtual uses exercise the terminator-sequence
# invariant without CFG edges. The second return is unreachable, but the MIR is
# accepted: no reload may be inserted between the two terminators.
# Debug instructions must not require residency; stale locations naming the
# spilled value are invalidated.
--- |
  define void @later_return_reload() "nonreentrant" !dbg !4 { ret void }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!3}
  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "test", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "test.c", directory: "/")
  !2 = !DISubroutineType(types: !{})
  !3 = !{i32 2, !"Debug Info Version", i32 3}
  !4 = distinct !DISubprogram(name: "later_return_reload", scope: !1, file: !1, line: 1, type: !2, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0)
  !5 = !DILocalVariable(name: "value", scope: !4, file: !1, line: 1, type: !6)
  !6 = !DIBasicType(name: "char", size: 8, encoding: DW_ATE_signed_char)
  !7 = !DILocation(line: 1, column: 1, scope: !4)
...
---
name: later_return_reload
tracksRegLiveness: true
body: |
  bb.0:
    ; STATIC-LABEL: name: later_return_reload
    ; STATIC: [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
    ; STATIC-NEXT: [[LDAbs1:%[0-9]+]]:gpr = LDAbs 1001
    ; STATIC-NEXT: [[LDAbs2:%[0-9]+]]:gpr = LDAbs 1002
    ; STATIC-NEXT: STAbs killed [[LDAbs]], %stack.0 :: (store (s8) into %stack.0)
    ; STATIC-NEXT: [[LDAbs3:%[0-9]+]]:gpr = LDAbs 1003
    ; STATIC-NEXT: STAbs killed [[LDAbs2]], 2000
    ; STATIC-NEXT: STAbs killed [[LDAbs3]], 2001
    ; STATIC-NEXT: DBG_VALUE [[LDAbs1]], $noreg, !6, !DIExpression(), debug-location !DILocation(line: 1, column: 1, scope: !3)
    ; STATIC-NEXT: [[LDAbs4:%[0-9]+]]:gpr = LDAbs %stack.0 :: (load (s8) from %stack.0)
    ; STATIC-NEXT: RTS implicit killed [[LDAbs4]]
    ; STATIC-NEXT: RTS implicit killed [[LDAbs1]]
    ;
    ; SOFT-LABEL: name: later_return_reload
    ; SOFT: [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
    ; SOFT-NEXT: [[LDAbs1:%[0-9]+]]:gpr = LDAbs 1001
    ; SOFT-NEXT: dead early-clobber %4:imag16 = STStk killed [[LDAbs]], %stack.0, 0 :: (store (s8) into %stack.0)
    ; SOFT-NEXT: [[LDAbs2:%[0-9]+]]:gpr = LDAbs 1002
    ; SOFT-NEXT: dead early-clobber %5:imag16 = STStk killed [[LDAbs1]], %stack.1, 0 :: (store (s8) into %stack.1)
    ; SOFT-NEXT: [[LDAbs3:%[0-9]+]]:gpr = LDAbs 1003
    ; SOFT-NEXT: STAbs killed [[LDAbs2]], 2000
    ; SOFT-NEXT: STAbs killed [[LDAbs3]], 2001
    ; SOFT-NEXT: DBG_VALUE $noreg, $noreg, !6, !DIExpression(), debug-location !DILocation(line: 1, column: 1, scope: !3)
    ; SOFT-NEXT: %6:gpr, dead early-clobber %7:imag16 = LDStk %stack.0, 0 :: (load (s8) from %stack.0)
    ; SOFT-NEXT: %8:gpr, dead early-clobber %9:imag16 = LDStk %stack.1, 0 :: (load (s8) from %stack.1)
    ; SOFT-NEXT: RTS implicit killed %6
    ; SOFT-NEXT: RTS implicit killed %8
    %0:gpr = LDAbs 1000
    %1:gpr = LDAbs 1001
    %2:gpr = LDAbs 1002
    %3:gpr = LDAbs 1003
    STAbs %2, 2000
    STAbs %3, 2001
    DBG_VALUE %1, $noreg, !5, !DIExpression(), debug-location !7
    RTS implicit %0
    RTS implicit %1
...
