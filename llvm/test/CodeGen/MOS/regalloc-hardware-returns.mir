# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mos -run-pass=mos-regalloc -verify-machineinstrs %s -o - | FileCheck %s

# Subroutine and interrupt returns are costed by their encodings.
---
name: subroutine_return
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: subroutine_return
    ; CHECK: RTS
    RTS
...
---
name: interrupt_return
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: interrupt_return
    ; CHECK: RTI
    RTI
...
