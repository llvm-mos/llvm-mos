# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mos -run-pass=mos-regalloc -verify-machineinstrs %s -o - | FileCheck %s

# Meta instructions produce no executable code. Their register operands still
# participate in allocation and liveness, and their frame indices are preserved.
---
name: meta_instructions
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr, assigned-phys: '$rc2' }
stack:
  - { id: 0, size: 1, alignment: 1 }
body: |
  bb.0:
    ; CHECK-LABEL: name: meta_instructions
    ; CHECK: LIFETIME_START %stack.0
    ; CHECK-NEXT: $a = IMPLICIT_DEF
    ; CHECK-NEXT: KILL killed $a
    ; CHECK-NEXT: LIFETIME_END %stack.0
    LIFETIME_START %stack.0
    %0:gpr = IMPLICIT_DEF
    KILL %0
    LIFETIME_END %stack.0
...
