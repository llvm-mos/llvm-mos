# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mos -run-pass=mos-regalloc -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=mos -mcpu=moshuc6280 -run-pass=mos-regalloc -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=mos -mcpu=mosspc700 -run-pass=mos-regalloc -verify-machineinstrs %s -o - | FileCheck %s

# Boolean materialization has different lowerings for C, V, and byte LSBs.
# Pin the other locations so each destination's cost is used.
---
name: set_carry
tracksRegLiveness: true
registers:
  - { id: 0, class: cv_gpr_lsb, assigned-phys: '$rc2lsb' }
body: |
  bb.0:
    liveins: $a, $x, $y, $v
    ; CHECK-LABEL: name: set_carry
    ; CHECK: liveins: $a, $x, $y, $v
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: dead $c = LDImm1 1
    ; CHECK-NEXT: RTS implicit killed $a, implicit killed $x, implicit killed $y, implicit killed $v
    %0:cv_gpr_lsb = LDImm1 1
    RTS implicit $a, implicit $x, implicit $y, implicit $v
...
---
name: clear_overflow
tracksRegLiveness: true
registers:
  - { id: 0, class: cv_gpr_lsb, assigned-phys: '$rc2lsb' }
body: |
  bb.0:
    liveins: $a, $x, $y, $c
    ; CHECK-LABEL: name: clear_overflow
    ; CHECK: liveins: $a, $x, $y, $c
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: dead $v = LDImm1 0
    ; CHECK-NEXT: RTS implicit killed $a, implicit killed $x, implicit killed $y, implicit killed $c
    %0:cv_gpr_lsb = LDImm1 0
    RTS implicit $a, implicit $x, implicit $y, implicit $c
...
---
name: set_overflow
tracksRegLiveness: true
registers:
  - { id: 0, class: cv_gpr_lsb, assigned-phys: '$rc2lsb' }
body: |
  bb.0:
    liveins: $a, $x, $y, $c
    ; CHECK-LABEL: name: set_overflow
    ; CHECK: liveins: $a, $x, $y, $c
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: dead $v = LDImm1 1
    ; CHECK-NEXT: RTS implicit killed $a, implicit killed $x, implicit killed $y, implicit killed $c
    %0:cv_gpr_lsb = LDImm1 1
    RTS implicit $a, implicit $x, implicit $y, implicit $c
...
---
name: byte_lsb
tracksRegLiveness: true
registers:
  - { id: 0, class: cv_gpr_lsb, assigned-phys: '$rc2lsb' }
body: |
  bb.0:
    liveins: $a, $y, $c, $v
    ; CHECK-LABEL: name: byte_lsb
    ; CHECK: liveins: $a, $y, $c, $v
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: dead $xlsb = LDImm1 0
    ; CHECK-NEXT: RTS implicit killed $a, implicit killed $y, implicit killed $c, implicit killed $v
    %0:cv_gpr_lsb = LDImm1 0
    RTS implicit $a, implicit $y, implicit $c, implicit $v
...
