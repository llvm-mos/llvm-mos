; Floating point comparisons are lowered to the GNU soft-float comparison
; libcalls (__ltsf2 etc.), which return a three-way -1/0/1 result.

define i1 @olt_f32(float %a, float %b) {
; CHECK-LABEL: olt_f32:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ; %bb.0: ; %entry
; CHECK-NEXT:    jsr __ltsf2
; CHECK-NEXT:    lda __rc3
; CHECK-NEXT:    bpl .LBB0_2
; CHECK-NEXT:  ; %bb.1: ; %entry
; CHECK-NEXT:    lda #1
; CHECK-NEXT:    rts
; CHECK-NEXT:  .LBB0_2: ; %entry
; CHECK-NEXT:    lda #0
; CHECK-NEXT:    rts
entry:
  %r = fcmp olt float %a, %b
  ret i1 %r
}

