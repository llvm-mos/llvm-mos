# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mos -mcpu=mos6502 -run-pass=mos-imag-reg-spill,mos-imag-reg-assign,mos-regalloc -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=CHECK,BASE
# RUN: llc -mtriple=mos -mcpu=mosspc700 -run-pass=mos-imag-reg-spill,mos-imag-reg-assign,mos-regalloc -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=CHECK,SPC

# Hardware allocation after imaginary spilling and assignment. Kill flags do not
# survive those passes, so liveness must come from the live intervals.

# %0 dies at its comparison, so %2 reuses its imaginary assignment. Storing %0
# afterwards would overwrite %2.
---
name: shared_home
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x, $y
    ; BASE-LABEL: name: shared_home
    ; BASE: liveins: $x, $y
    ; BASE-NEXT: {{  $}}
    ; BASE-NEXT: $a = LDImm 1
    ; BASE-NEXT: dead $c = CMPImm killed $a, 1
    ; BASE-NEXT: $a = LDImm 2
    ; BASE-NEXT: $rc2 = COPY killed $a
    ; BASE-NEXT: $a = LDImm 3
    ; BASE-NEXT: dead $c = CMPImm killed $a, 3
    ; BASE-NEXT: $a = COPY killed $rc2
    ; BASE-NEXT: dead $c = CMPImm killed $a, 2
    ; BASE-NEXT: RTS implicit killed $x, implicit killed $y
    ;
    ; SPC-LABEL: name: shared_home
    ; SPC: liveins: $x, $y
    ; SPC-NEXT: {{  $}}
    ; SPC-NEXT: $a = LDImm 1
    ; SPC-NEXT: dead $c = CMPImm killed $a, 1
    ; SPC-NEXT: $rc2 = LDImm 2
    ; SPC-NEXT: $a = LDImm 3
    ; SPC-NEXT: dead $c = CMPImm killed $a, 3
    ; SPC-NEXT: $a = COPY killed $rc2
    ; SPC-NEXT: dead $c = CMPImm killed $a, 2
    ; SPC-NEXT: RTS implicit killed $x, implicit killed $y
    %0:gpr = LDImm 1
    %1:cc = CMPImm %0, 1
    %2:gpr = LDImm 2
    %3:gpr = LDImm 3
    %4:cc = CMPImm %3, 3
    %5:cc = CMPImm %2, 2
    RTS implicit $x, implicit $y
...

# A carry value survives a later comparison through a byte's LSB.
---
name: preserve_carry
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: preserve_carry
    ; CHECK: $a = LDImm 1
    ; CHECK-NEXT: $c = CMPImm killed $a, 2
    ; CHECK-NEXT: $a = LDImm 3
    ; CHECK-NEXT: $xlsb = COPY killed $c
    ; CHECK-NEXT: dead $c = CMPImm killed $a, 3
    ; CHECK-NEXT: dead $xlsb = COPY killed $xlsb
    ; CHECK-NEXT: RTS
    %0:gpr = LDImm 1
    %1:cc = CMPImm %0, 2
    %2:gpr = LDImm 3
    %3:cc = CMPImm %2, 3
    %4:anyi1 = COPY %1
    RTS
...
