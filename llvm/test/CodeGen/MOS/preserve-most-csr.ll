; A preserve_most function must save and restore every imaginary register it
; clobbers, except __rc16 and __rc17 (RS8, the register scavenger slot), which
; are caller-saved under this convention. A, X, and Y are never saved.

target datalayout = "e-m:e-p:16:8-p1:8:8-i16:8-i32:8-i64:8-f32:8-f64:8-a:8-Fi8-n8"
target triple = "mos"

declare void @use()
declare i8 @use_i8(i8)
declare preserve_mostcc void @pm_callee()

