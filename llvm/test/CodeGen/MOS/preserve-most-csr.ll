; A preserve_most function that clobbers no imaginary registers saves nothing:
; not even A, which is caller-saved under this convention.
define preserve_mostcc i8 @no_call(i8 %a) {
; CHECK-LABEL: no_call:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    clc
; CHECK-NEXT:    adc #1
; CHECK-NEXT:    rts
entry:
  %r = add i8 %a, 1
  ret i8 %r
}

; Calling another preserve_most function clobbers only A, X, Y, and RS8, so
; nothing needs to be saved.
define preserve_mostcc void @call_pm() {
; CHECK-LABEL: call_pm:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    jmp pm_callee
entry:
  call preserve_mostcc void @pm_callee()
  ret void
}

