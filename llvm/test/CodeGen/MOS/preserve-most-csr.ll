; A tail call into another preserve_most function is fine, since the callee
; preserves the same set.
define preserve_mostcc void @tail_call_into_pm() {
; CHECK-LABEL: tail_call_into_pm:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    jmp pm_callee
entry:
  tail call preserve_mostcc void @pm_callee()
  ret void
}

