# RUN: llc -mtriple=mos -mcpu=mos65c02 -run-pass=mos-regalloc -verify-machineinstrs %s -o - | FileCheck %s

# Debug operands do not keep SSA values alive or add actions. Constants and
# physical debug operands survive unchanged. Leave the choice of how to describe
# virtual debug operands unconstrained while their tracking is pending.
--- |
  define void @debug_operands() !dbg !4 { ret void, !dbg !8 }
  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!3}
  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "test", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "test.c", directory: "/")
  !2 = !{}
  !3 = !{i32 2, !"Debug Info Version", i32 3}
  !4 = distinct !DISubprogram(name: "debug_operands", scope: !1, file: !1, line: 1, type: !5, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !2)
  !5 = !DISubroutineType(types: !2)
  !6 = !DILocalVariable(name: "value", scope: !4, file: !1, line: 1, type: !7)
  !7 = !DIBasicType(name: "unsigned char", size: 8, encoding: DW_ATE_unsigned_char)
  !8 = !DILocation(line: 1, column: 1, scope: !4)
...
---
name: debug_operands
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr, assigned-phys: '$rc2' }
body: |
  bb.0:
    liveins: $x
    ; CHECK-LABEL: name: debug_operands
    ; CHECK: DBG_VALUE 42, $noreg,
    ; CHECK-NEXT: DBG_VALUE $x, $noreg,
    ; CHECK-NEXT: dead $a = LDImm 1
    ; CHECK-NOT: COPY
    ; CHECK: RTS implicit killed $x
    DBG_VALUE 42, $noreg, !6, !DIExpression(), debug-location !8
    DBG_VALUE $x, $noreg, !6, !DIExpression(), debug-location !8
    %0:gpr = LDImm 1
    DBG_VALUE %0, $noreg, !6, !DIExpression(), debug-location !8
    DBG_VALUE_LIST !6, !DIExpression(DW_OP_LLVM_arg, 0, DW_OP_LLVM_arg, 1, DW_OP_plus), %0, 1, debug-location !8
    DBG_PHI %0, 1
    RTS implicit $x
...
