; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -verify-machineinstrs -O2 < %s | FileCheck %s

; Test that preserve_most arguments are passed in the hard registers A, X, and
; Y only; further values are passed on the stack. No imaginary registers are
; used to pass arguments, so that callers and callees that refer to different
; imaginary register symbols still agree on where arguments live.

target datalayout = "e-m:e-p:16:8-p1:8:8-i16:8-i32:8-i64:8-f32:8-f64:8-a:8-Fi8-n8"
target triple = "mos"

declare preserve_mostcc i8 @pm3(i8, i8, i8)
declare preserve_mostcc i8 @pm4(i8, i8, i8, i8)
declare preserve_mostcc void @pm_ptr(ptr)
declare preserve_mostcc ptr @pm_ret_ptr()

; The first three arguments are passed in A, X, and Y.
define i8 @call_pm3() {
; CHECK-LABEL: call_pm3:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    lda #1
; CHECK-NEXT:    ldx #2
; CHECK-NEXT:    ldy #3
; CHECK-NEXT:    jsr pm3
; CHECK-NEXT:    clc
; CHECK-NEXT:    adc #1
; CHECK-NEXT:    rts
entry:
  %r = call preserve_mostcc i8 @pm3(i8 1, i8 2, i8 3)
  %r2 = add i8 %r, 1
  ret i8 %r2
}

; The fourth argument is passed on the stack.
define i8 @call_pm4() {
; CHECK-LABEL: call_pm4:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    clc
; CHECK-NEXT:    lda __rc0
; CHECK-NEXT:    adc #255
; CHECK-NEXT:    sta __rc0
; CHECK-NEXT:    lda __rc1
; CHECK-NEXT:    adc #255
; CHECK-NEXT:    sta __rc1
; CHECK-NEXT:    ldy #0
; CHECK-NEXT:    lda #4
; CHECK-NEXT:    sta (__rc0),y
; CHECK-NEXT:    lda #1
; CHECK-NEXT:    ldx #2
; CHECK-NEXT:    ldy #3
; CHECK-NEXT:    jsr pm4
; CHECK-NEXT:    clc
; CHECK-NEXT:    adc #1
; CHECK-NEXT:    pha
; CHECK-NEXT:    clc
; CHECK-NEXT:    lda __rc0
; CHECK-NEXT:    adc #1
; CHECK-NEXT:    sta __rc0
; CHECK-NEXT:    lda __rc1
; CHECK-NEXT:    adc #0
; CHECK-NEXT:    sta __rc1
; CHECK-NEXT:    pla
; CHECK-NEXT:    rts
entry:
  %r = call preserve_mostcc i8 @pm4(i8 1, i8 2, i8 3, i8 4)
  %r2 = add i8 %r, 1
  ret i8 %r2
}

; Pointers are passed on the stack, not in RS registers.
define void @call_pm_ptr(ptr %p) {
; CHECK-LABEL: call_pm_ptr:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    clc
; CHECK-NEXT:    lda __rc0
; CHECK-NEXT:    adc #254
; CHECK-NEXT:    sta __rc0
; CHECK-NEXT:    lda __rc1
; CHECK-NEXT:    adc #255
; CHECK-NEXT:    sta __rc1
; CHECK-NEXT:    lda __rc2
; CHECK-NEXT:    ldy #0
; CHECK-NEXT:    sta (__rc0),y
; CHECK-NEXT:    iny
; CHECK-NEXT:    lda __rc3
; CHECK-NEXT:    sta (__rc0),y
; CHECK-NEXT:    jsr pm_ptr
; CHECK-NEXT:    clc
; CHECK-NEXT:    lda __rc0
; CHECK-NEXT:    adc #2
; CHECK-NEXT:    sta __rc0
; CHECK-NEXT:    lda __rc1
; CHECK-NEXT:    adc #0
; CHECK-NEXT:    sta __rc1
; CHECK-NEXT:    rts
entry:
  call preserve_mostcc void @pm_ptr(ptr %p)
  ret void
}

; Pointer results are also returned on the stack, not in RS registers.
define ptr @call_pm_ret_ptr() {
; CHECK-LABEL: call_pm_ret_ptr:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    clc
; CHECK-NEXT:    lda __rc0
; CHECK-NEXT:    adc #254
; CHECK-NEXT:    sta __rc0
; CHECK-NEXT:    lda __rc1
; CHECK-NEXT:    adc #255
; CHECK-NEXT:    sta __rc1
; CHECK-NEXT:    jsr pm_ret_ptr
; CHECK-NEXT:    ldy #0
; CHECK-NEXT:    lda (__rc0),y
; CHECK-NEXT:    sta __rc2
; CHECK-NEXT:    iny
; CHECK-NEXT:    lda (__rc0),y
; CHECK-NEXT:    sta __rc3
; CHECK-NEXT:    clc
; CHECK-NEXT:    lda __rc0
; CHECK-NEXT:    adc #2
; CHECK-NEXT:    sta __rc0
; CHECK-NEXT:    lda __rc1
; CHECK-NEXT:    adc #0
; CHECK-NEXT:    sta __rc1
; CHECK-NEXT:    rts
entry:
  %p = call preserve_mostcc ptr @pm_ret_ptr()
  ret ptr %p
}

; The callee receives the arguments in A, X, and Y; X and Y are moved into
; imaginary registers, which must then be saved and restored.
define preserve_mostcc i8 @pm_args(i8 %a, i8 %b, i8 %c) {
; CHECK-LABEL: pm_args:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    sta __rc16
; CHECK-NEXT:    lda __rc2
; CHECK-NEXT:    pha
; CHECK-NEXT:    lda __rc3
; CHECK-NEXT:    pha
; CHECK-NEXT:    lda __rc16
; CHECK-NEXT:    stx __rc2
; CHECK-NEXT:    sty __rc3
; CHECK-NEXT:    clc
; CHECK-NEXT:    adc __rc2
; CHECK-NEXT:    clc
; CHECK-NEXT:    adc __rc3
; CHECK-NEXT:    sta __rc16
; CHECK-NEXT:    pla
; CHECK-NEXT:    sta __rc3
; CHECK-NEXT:    pla
; CHECK-NEXT:    sta __rc2
; CHECK-NEXT:    lda __rc16
; CHECK-NEXT:    rts
entry:
  %s1 = add i8 %a, %b
  %s2 = add i8 %s1, %c
  ret i8 %s2
}

; The callee reads a pointer argument from the stack.
define preserve_mostcc i8 @pm_load_ptr(ptr %p) {
; CHECK-LABEL: pm_load_ptr:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    lda __rc2
; CHECK-NEXT:    pha
; CHECK-NEXT:    lda __rc3
; CHECK-NEXT:    pha
; CHECK-NEXT:    lda __rc4
; CHECK-NEXT:    pha
; CHECK-NEXT:    ldy #0
; CHECK-NEXT:    clc
; CHECK-NEXT:    ldx __rc0
; CHECK-NEXT:    stx __rc2
; CHECK-NEXT:    ldx __rc1
; CHECK-NEXT:    stx __rc3
; CHECK-NEXT:    lda (__rc2),y
; CHECK-NEXT:    sta __rc4
; CHECK-NEXT:    ldx #0
; CHECK-NEXT:    iny
; CHECK-NEXT:    lda (__rc2),y
; CHECK-NEXT:    ldx __rc4
; CHECK-NEXT:    stx __rc2
; CHECK-NEXT:    sta __rc3
; CHECK-NEXT:    dey
; CHECK-NEXT:    lda (__rc2),y
; CHECK-NEXT:    sta __rc16
; CHECK-NEXT:    pla
; CHECK-NEXT:    sta __rc4
; CHECK-NEXT:    pla
; CHECK-NEXT:    sta __rc3
; CHECK-NEXT:    pla
; CHECK-NEXT:    sta __rc2
; CHECK-NEXT:    lda __rc16
; CHECK-NEXT:    rts
entry:
  %v = load i8, ptr %p
  ret i8 %v
}
