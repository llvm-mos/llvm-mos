    %7:ac = LDIndir %2
    %8:ac = LDIndir %3
    RTS
...

# Flags require imaginary storage too. Static stores widen them to whole
# bytes; soft-stack transfers preserve the bit-sized payload.
---
name: flags
tracksRegLiveness: true
body: |
  bb.0:
    ; STATIC-LABEL: name: flags
    ; STATIC: [[LDImm1_:%[0-9]+]]:cc = LDImm1 0
