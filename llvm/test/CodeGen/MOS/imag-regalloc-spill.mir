# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mos -mattr=+static-stack -stress-regalloc=5 -run-pass=mos-imag-reg-spill -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=STATIC
# RUN: llc -mtriple=mos -mattr=-static-stack -stress-regalloc=4 -run-pass=mos-imag-reg-spill -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=SOFT

# Straight-line spilling: all virtual operands are whole and untied.
# Restrict the allocation orders to exercise pressure with small examples.
--- |
  define void @no_spills() "nonreentrant" { ret void }
  define void @bytes() "nonreentrant" { ret void }
  define void @pairs() "nonreentrant" { ret void }
  define void @flags() "nonreentrant" { ret void }
  define void @repeated_use() "nonreentrant" { ret void }
  define void @mixed_classes() "nonreentrant" { ret void }
  define void @undef_phys() "nonreentrant" { ret void }
...
# Killed inputs and dead results release storage before the next instruction.
# COPY and REG_SEQUENCE have whole-register operands; subregister indices in
# REG_SEQUENCE are immediates and do not require partial-register tracking.
---
name: no_spills
tracksRegLiveness: true
body: |
  bb.0:
    ; STATIC-LABEL: name: no_spills
    ; STATIC: [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
    ; STATIC-NEXT: [[LDAbs1:%[0-9]+]]:gpr = LDAbs 1001
    ; STATIC-NEXT: [[REG_SEQUENCE:%[0-9]+]]:imag16 = REG_SEQUENCE killed [[LDAbs]], %subreg.sublo, killed [[LDAbs1]], %subreg.subhi
    ; STATIC-NEXT: [[LDIndir:%[0-9]+]]:ac = LDIndir killed [[REG_SEQUENCE]]
    ; STATIC-NEXT: [[COPY:%[0-9]+]]:imag8 = COPY killed [[LDIndir]]
    ; STATIC-NEXT: [[COPY1:%[0-9]+]]:xy = COPY killed [[COPY]]
    ; STATIC-NEXT: [[COPY2:%[0-9]+]]:gpr = COPY killed [[COPY1]]
    ; STATIC-NEXT: dead [[LDAbs2:%[0-9]+]]:gpr = LDAbs 1002
    ; STATIC-NEXT: CmpZero killed [[COPY2]], implicit-def dead $c
    ; STATIC-NEXT: RTS
    ;
    ; SOFT-LABEL: name: no_spills
    ; SOFT: [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
    ; SOFT-NEXT: [[LDAbs1:%[0-9]+]]:gpr = LDAbs 1001
    ; SOFT-NEXT: [[REG_SEQUENCE:%[0-9]+]]:imag16 = REG_SEQUENCE killed [[LDAbs]], %subreg.sublo, killed [[LDAbs1]], %subreg.subhi
    ; SOFT-NEXT: [[LDIndir:%[0-9]+]]:ac = LDIndir killed [[REG_SEQUENCE]]
    ; SOFT-NEXT: [[COPY:%[0-9]+]]:imag8 = COPY killed [[LDIndir]]
    ; SOFT-NEXT: [[COPY1:%[0-9]+]]:xy = COPY killed [[COPY]]
    ; SOFT-NEXT: [[COPY2:%[0-9]+]]:gpr = COPY killed [[COPY1]]
    ; SOFT-NEXT: dead [[LDAbs2:%[0-9]+]]:gpr = LDAbs 1002
    ; SOFT-NEXT: CmpZero killed [[COPY2]], implicit-def dead $c
    ; SOFT-NEXT: RTS
    %0:gpr = LDAbs 1000
    %1:gpr = LDAbs 1001
    %2:imag16 = REG_SEQUENCE %0, %subreg.sublo, %1, %subreg.subhi
    %3:ac = LDIndir %2
    %4:imag8 = COPY %3
    %5:xy = COPY %4
    %6:gpr = COPY %5
    %7:gpr = LDAbs 1002
    CmpZero %6, implicit-def $c
    RTS
...

# Save live-through values, reload at uses, and reuse both the stack slot and
# the saved copy when a reloaded value is evicted again.
---
name: bytes
tracksRegLiveness: true
body: |
  bb.0:
    ; STATIC-LABEL: name: bytes
    ; STATIC: [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
    ; STATIC-NEXT: [[LDAbs1:%[0-9]+]]:gpr = LDAbs 1001
