    ; SOFT-NEXT: dead early-clobber %8:imag16 = STStk killed [[LDImm16Remat]], %stack.0, 0 :: (store (s16) into %stack.0, align 1)
    ; SOFT-NEXT: [[LDImm16Remat3:%[0-9]+]]:imag16 = LDImm16Remat 1003
    ; SOFT-NEXT: dead early-clobber %9:imag16 = STStk killed [[LDImm16Remat1]], %stack.1, 0 :: (store (s16) into %stack.1, align 1)
    ; SOFT-NEXT: dead early-clobber %10:imag16 = STStk killed [[LDImm16Remat2]], %stack.2, 0 :: (store (s16) into %stack.2, align 1)
    ; SOFT-NEXT: %11:imag16, dead early-clobber %12:imag16 = LDStk %stack.0, 0 :: (load (s16) from %stack.0, align 1)
    ; SOFT-NEXT: dead [[LDIndir:%[0-9]+]]:ac = LDIndir killed %11
    ; SOFT-NEXT: %13:imag16, dead early-clobber %14:imag16 = LDStk %stack.1, 0 :: (load (s16) from %stack.1, align 1)
    ; SOFT-NEXT: dead [[LDIndir1:%[0-9]+]]:ac = LDIndir killed %13
    ; SOFT-NEXT: %15:imag16, dead early-clobber %16:imag16 = LDStk %stack.2, 0 :: (load (s16) from %stack.2, align 1)
    ; SOFT-NEXT: dead [[LDIndir2:%[0-9]+]]:ac = LDIndir killed %15
    ; SOFT-NEXT: dead [[LDIndir3:%[0-9]+]]:ac = LDIndir killed [[LDImm16Remat3]]
    ; SOFT-NEXT: RTS
    %0:imag16 = LDImm16Remat 1000
    %1:imag16 = LDImm16Remat 1001
    %2:imag16 = LDImm16Remat 1002
    %3:imag16 = LDImm16Remat 1003
