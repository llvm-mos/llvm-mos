    ; STATIC-NEXT: [[LDAbs4:%[0-9]+]]:gpr = LDAbs 1004
    ; STATIC-NEXT: STAbs killed [[LDAbs4]], %stack.3 :: (store (s8) into %stack.3)
    ; STATIC-NEXT: [[LDAbs5:%[0-9]+]]:gpr = LDAbs %stack.0 :: (load (s8) from %stack.0)
    ; STATIC-NEXT: STAbs killed [[LDAbs5]], 2000
    ; STATIC-NEXT: [[LDAbs6:%[0-9]+]]:gpr = LDAbs %stack.1 :: (load (s8) from %stack.1)
    ; STATIC-NEXT: STAbs killed [[LDAbs6]], 2001
    ; STATIC-NEXT: [[LDAbs7:%[0-9]+]]:gpr = LDAbs %stack.2 :: (load (s8) from %stack.2)
    ; STATIC-NEXT: STAbs killed [[LDAbs7]], 2002
    ; STATIC-NEXT: STAbs [[LDAbs3]], 2003
    ; STATIC-NEXT: [[LDAbs8:%[0-9]+]]:gpr = LDAbs %stack.3 :: (load (s8) from %stack.3)
