# A repeated input needs one reload, and both operands must use the new name.
---
name: repeated_use
tracksRegLiveness: true
body: |
  bb.0:
    ; STATIC-LABEL: name: repeated_use
    ; STATIC: [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
    ; STATIC-NEXT: [[LDAbs1:%[0-9]+]]:gpr = LDAbs 1001
    ; STATIC-NEXT: STAbs killed [[LDAbs]], %stack.0 :: (store (s8) into %stack.0)
    ; STATIC-NEXT: [[LDAbs2:%[0-9]+]]:gpr = LDAbs 1002
    ; STATIC-NEXT: STAbs killed [[LDAbs1]], %stack.1 :: (store (s8) into %stack.1)
    ; STATIC-NEXT: [[LDAbs3:%[0-9]+]]:gpr = LDAbs 1003
    ; STATIC-NEXT: STAbs killed [[LDAbs2]], %stack.2 :: (store (s8) into %stack.2)
    ; STATIC-NEXT: [[LDAbs4:%[0-9]+]]:gpr = LDAbs 1004
    ; STATIC-NEXT: STAbs killed [[LDAbs4]], %stack.3 :: (store (s8) into %stack.3)
    ; STATIC-NEXT: [[LDAbs5:%[0-9]+]]:gpr = LDAbs %stack.0 :: (load (s8) from %stack.0)
    ; STATIC-NEXT: STAbs killed [[LDAbs5]], 2000
    ; STATIC-NEXT: [[LDAbs6:%[0-9]+]]:gpr = LDAbs %stack.2 :: (load (s8) from %stack.2)
    ; STATIC-NEXT: STAbs killed [[LDAbs6]], 2002
    ; STATIC-NEXT: STAbs killed [[LDAbs3]], 2003
    ; STATIC-NEXT: [[LDAbs7:%[0-9]+]]:gpr = LDAbs %stack.3 :: (load (s8) from %stack.3)
    ; STATIC-NEXT: STAbs killed [[LDAbs7]], 2004
    ; STATIC-NEXT: [[LDAbs8:%[0-9]+]]:gpr = LDAbs %stack.1 :: (load (s8) from %stack.1)
    ; STATIC-NEXT: [[REG_SEQUENCE:%[0-9]+]]:imag16 = REG_SEQUENCE killed [[LDAbs8]], %subreg.sublo, [[LDAbs8]], %subreg.subhi
    ; STATIC-NEXT: dead [[LDIndir:%[0-9]+]]:ac = LDIndir killed [[REG_SEQUENCE]]
    ; STATIC-NEXT: RTS
    ;
    ; SOFT-LABEL: name: repeated_use
    ; SOFT: [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
    ; SOFT-NEXT: [[LDAbs1:%[0-9]+]]:gpr = LDAbs 1001
    ; SOFT-NEXT: [[LDAbs2:%[0-9]+]]:gpr = LDAbs 1002
    ; SOFT-NEXT: dead early-clobber %7:imag16 = STStk killed [[LDAbs]], %stack.0, 0 :: (store (s8) into %stack.0)
    ; SOFT-NEXT: [[LDAbs3:%[0-9]+]]:gpr = LDAbs 1003
    ; SOFT-NEXT: dead early-clobber %8:imag16 = STStk killed [[LDAbs1]], %stack.1, 0 :: (store (s8) into %stack.1)
    ; SOFT-NEXT: [[LDAbs4:%[0-9]+]]:gpr = LDAbs 1004
    ; SOFT-NEXT: dead early-clobber %9:imag16 = STStk killed [[LDAbs2]], %stack.2, 0 :: (store (s8) into %stack.2)
    ; SOFT-NEXT: %10:gpr, dead early-clobber %11:imag16 = LDStk %stack.0, 0 :: (load (s8) from %stack.0)
    ; SOFT-NEXT: STAbs killed %10, 2000
    ; SOFT-NEXT: %12:gpr, dead early-clobber %13:imag16 = LDStk %stack.2, 0 :: (load (s8) from %stack.2)
    ; SOFT-NEXT: STAbs killed %12, 2002
    ; SOFT-NEXT: STAbs killed [[LDAbs3]], 2003
    ; SOFT-NEXT: STAbs killed [[LDAbs4]], 2004
    ; SOFT-NEXT: %14:gpr, dead early-clobber %15:imag16 = LDStk %stack.1, 0 :: (load (s8) from %stack.1)
    ; SOFT-NEXT: [[REG_SEQUENCE:%[0-9]+]]:imag16 = REG_SEQUENCE killed %14, %subreg.sublo, %14, %subreg.subhi
    ; SOFT-NEXT: dead [[LDIndir:%[0-9]+]]:ac = LDIndir killed [[REG_SEQUENCE]]
    ; SOFT-NEXT: RTS
    %0:gpr = LDAbs 1000
    %1:gpr = LDAbs 1001
    %2:gpr = LDAbs 1002
    %3:gpr = LDAbs 1003
    %4:gpr = LDAbs 1004
    STAbs %0, 2000
    STAbs %2, 2002
    STAbs %3, 2003
    STAbs %4, 2004
    %5:imag16 = REG_SEQUENCE %1, %subreg.sublo, %1, %subreg.subhi
    %6:ac = LDIndir %5
    RTS
...

# Bits, bytes, and pairs alias. Squeeze must use imaginary storage classes,
# including for values whose instruction classes contain only hardware regs.
---
name: mixed_classes
tracksRegLiveness: true
body: |
  bb.0:
    ; STATIC-LABEL: name: mixed_classes
    ; STATIC: [[LDImm1_:%[0-9]+]]:cc = LDImm1 1
    ; STATIC-NEXT: [[LDImm16Remat:%[0-9]+]]:imag16 = LDImm16Remat 1000
    ; STATIC-NEXT: [[REG_SEQUENCE:%[0-9]+]]:gpr = REG_SEQUENCE killed [[LDImm1_]], %subreg.sublsb
    ; STATIC-NEXT: STAbs killed [[REG_SEQUENCE]], %stack.0 :: (store (s8) into %stack.0)
    ; STATIC-NEXT: [[LDAbs:%[0-9]+]]:gpr = LDAbs 1001
    ; STATIC-NEXT: [[COPY:%[0-9]+]]:imag16 = COPY killed [[LDImm16Remat]]
    ; STATIC-NEXT: [[COPY1:%[0-9]+]]:gpr = COPY [[COPY]].sublo
    ; STATIC-NEXT: STAbs killed [[COPY1]], %stack.1 :: (store (s8) into %stack.1)
    ; STATIC-NEXT: [[COPY2:%[0-9]+]]:gpr = COPY killed [[COPY]].subhi
    ; STATIC-NEXT: STAbs killed [[COPY2]], %stack.1 + 1 :: (store (s8) into %stack.1 + 1)
    ; STATIC-NEXT: [[DEF:%[0-9]+]]:vc = IMPLICIT_DEF
    ; STATIC-NEXT: STAbs killed [[LDAbs]], %stack.2 :: (store (s8) into %stack.2)
    ; STATIC-NEXT: [[LDAbs1:%[0-9]+]]:gpr = LDAbs 1002
    ; STATIC-NEXT: STAbs killed [[LDAbs1]], 2000
    ; STATIC-NEXT: [[LDAbs2:%[0-9]+]]:gpr = LDAbs %stack.0 :: (load (s8) from %stack.0)
    ; STATIC-NEXT: [[COPY3:%[0-9]+]]:cc = COPY killed [[LDAbs2]].sublsb
    ; STATIC-NEXT: [[REG_SEQUENCE1:%[0-9]+]]:gpr = REG_SEQUENCE killed [[COPY3]], %subreg.sublsb
    ; STATIC-NEXT: STAbs killed [[REG_SEQUENCE1]], 2001
    ; STATIC-NEXT: [[LDAbs3:%[0-9]+]]:gpr = LDAbs %stack.1 :: (load (s8) from %stack.1)
    ; STATIC-NEXT: [[LDAbs4:%[0-9]+]]:gpr = LDAbs %stack.1 + 1 :: (load (s8) from %stack.1 + 1)
    ; STATIC-NEXT: [[REG_SEQUENCE2:%[0-9]+]]:imag16 = REG_SEQUENCE killed [[LDAbs3]], %subreg.sublo, killed [[LDAbs4]], %subreg.subhi
    ; STATIC-NEXT: dead [[LDIndir:%[0-9]+]]:ac = LDIndir killed [[REG_SEQUENCE2]]
    ; STATIC-NEXT: [[LDAbs5:%[0-9]+]]:gpr = LDAbs %stack.2 :: (load (s8) from %stack.2)
    ; STATIC-NEXT: STAbs killed [[LDAbs5]], 2002
    ; STATIC-NEXT: [[REG_SEQUENCE3:%[0-9]+]]:gpr = REG_SEQUENCE killed [[DEF]], %subreg.sublsb
    ; STATIC-NEXT: STAbs killed [[REG_SEQUENCE3]], 2003
    ; STATIC-NEXT: RTS
    ;
    ; SOFT-LABEL: name: mixed_classes
    ; SOFT: [[LDImm1_:%[0-9]+]]:cc = LDImm1 1
    ; SOFT-NEXT: [[LDImm16Remat:%[0-9]+]]:imag16 = LDImm16Remat 1000
    ; SOFT-NEXT: [[LDAbs:%[0-9]+]]:gpr = LDAbs 1001
    ; SOFT-NEXT: dead early-clobber %8:imag16 = STStk killed [[LDImm1_]], %stack.0, 0 :: (store (s8) into %stack.0)
    ; SOFT-NEXT: [[DEF:%[0-9]+]]:vc = IMPLICIT_DEF
    ; SOFT-NEXT: dead early-clobber %9:imag16 = STStk killed [[LDImm16Remat]], %stack.1, 0 :: (store (s16) into %stack.1, align 1)
    ; SOFT-NEXT: [[LDAbs1:%[0-9]+]]:gpr = LDAbs 1002
    ; SOFT-NEXT: STAbs killed [[LDAbs1]], 2000
    ; SOFT-NEXT: %10:cc, dead early-clobber %11:imag16 = LDStk %stack.0, 0 :: (load (s8) from %stack.0)
    ; SOFT-NEXT: [[REG_SEQUENCE:%[0-9]+]]:gpr = REG_SEQUENCE killed %10, %subreg.sublsb
    ; SOFT-NEXT: STAbs killed [[REG_SEQUENCE]], 2001
    ; SOFT-NEXT: %12:imag16, dead early-clobber %13:imag16 = LDStk %stack.1, 0 :: (load (s16) from %stack.1, align 1)
    ; SOFT-NEXT: dead [[LDIndir:%[0-9]+]]:ac = LDIndir killed %12
    ; SOFT-NEXT: STAbs killed [[LDAbs]], 2002
    ; SOFT-NEXT: [[REG_SEQUENCE1:%[0-9]+]]:gpr = REG_SEQUENCE killed [[DEF]], %subreg.sublsb
    ; SOFT-NEXT: STAbs killed [[REG_SEQUENCE1]], 2003
    ; SOFT-NEXT: RTS
    %0:cc = LDImm1 1
    %1:imag16 = LDImm16Remat 1000
    %2:gpr = LDAbs 1001
    %3:vc = IMPLICIT_DEF
    %4:gpr = LDAbs 1002
    STAbs %4, 2000
    %5:gpr = REG_SEQUENCE %0, %subreg.sublsb
    STAbs %5, 2001
    %6:ac = LDIndir %1
    STAbs %2, 2002
    %7:gpr = REG_SEQUENCE %3, %subreg.sublsb
    STAbs %7, 2003
    RTS
...

# An undef physical input needs neither a live-in nor a physical placement.
---
name: undef_phys
tracksRegLiveness: true
body: |
  bb.0:
    ; STATIC-LABEL: name: undef_phys
    ; STATIC: [[COPY:%[0-9]+]]:gpr = COPY undef $a
    ; STATIC-NEXT: STAbs killed [[COPY]], 2000
    ; STATIC-NEXT: RTS
    ;
    ; SOFT-LABEL: name: undef_phys
    ; SOFT: [[COPY:%[0-9]+]]:gpr = COPY undef $a
    ; SOFT-NEXT: STAbs killed [[COPY]], 2000
    ; SOFT-NEXT: RTS
    %0:gpr = COPY undef $a
    STAbs %0, 2000
    RTS
...
