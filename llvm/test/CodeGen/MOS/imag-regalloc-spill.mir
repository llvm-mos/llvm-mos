# Pair spills occupy two bytes. Static-stack reloads must assemble one SSA
# definition rather than defining the destination separately for each byte.
# Stress limits each class independently. Earlier pairs can exhaust the
# byte candidates; spill before that can happen, preserving transfer scratch
# regardless of the pairs' eventual assignments.
---
name: pairs
tracksRegLiveness: true
body: |
  bb.0:
    ; STATIC-LABEL: name: pairs
    ; STATIC: [[LDImm16Remat:%[0-9]+]]:imag16 = LDImm16Remat 1000
    ; STATIC-NEXT: [[COPY:%[0-9]+]]:imag16 = COPY killed [[LDImm16Remat]]
    ; STATIC-NEXT: [[COPY1:%[0-9]+]]:gpr = COPY [[COPY]].sublo
    ; STATIC-NEXT: STAbs killed [[COPY1]], %stack.0 :: (store (s8) into %stack.0)
    ; STATIC-NEXT: [[COPY2:%[0-9]+]]:gpr = COPY killed [[COPY]].subhi
    ; STATIC-NEXT: STAbs killed [[COPY2]], %stack.0 + 1 :: (store (s8) into %stack.0 + 1)
    ; STATIC-NEXT: [[LDImm16Remat1:%[0-9]+]]:imag16 = LDImm16Remat 1001
    ; STATIC-NEXT: [[COPY3:%[0-9]+]]:imag16 = COPY killed [[LDImm16Remat1]]
    ; STATIC-NEXT: [[COPY4:%[0-9]+]]:gpr = COPY [[COPY3]].sublo
    ; STATIC-NEXT: STAbs killed [[COPY4]], %stack.1 :: (store (s8) into %stack.1)
    ; STATIC-NEXT: [[COPY5:%[0-9]+]]:gpr = COPY killed [[COPY3]].subhi
    ; STATIC-NEXT: STAbs killed [[COPY5]], %stack.1 + 1 :: (store (s8) into %stack.1 + 1)
    ; STATIC-NEXT: [[LDImm16Remat2:%[0-9]+]]:imag16 = LDImm16Remat 1002
    ; STATIC-NEXT: [[COPY6:%[0-9]+]]:imag16 = COPY killed [[LDImm16Remat2]]
    ; STATIC-NEXT: [[COPY7:%[0-9]+]]:gpr = COPY [[COPY6]].sublo
    ; STATIC-NEXT: STAbs killed [[COPY7]], %stack.2 :: (store (s8) into %stack.2)
    ; STATIC-NEXT: [[COPY8:%[0-9]+]]:gpr = COPY killed [[COPY6]].subhi
    ; STATIC-NEXT: STAbs killed [[COPY8]], %stack.2 + 1 :: (store (s8) into %stack.2 + 1)
    ; STATIC-NEXT: [[LDImm16Remat3:%[0-9]+]]:imag16 = LDImm16Remat 1003
    ; STATIC-NEXT: [[COPY9:%[0-9]+]]:imag16 = COPY killed [[LDImm16Remat3]]
    ; STATIC-NEXT: [[COPY10:%[0-9]+]]:gpr = COPY [[COPY9]].sublo
    ; STATIC-NEXT: STAbs killed [[COPY10]], %stack.3 :: (store (s8) into %stack.3)
    ; STATIC-NEXT: [[COPY11:%[0-9]+]]:gpr = COPY killed [[COPY9]].subhi
    ; STATIC-NEXT: STAbs killed [[COPY11]], %stack.3 + 1 :: (store (s8) into %stack.3 + 1)
    ; STATIC-NEXT: [[LDAbs:%[0-9]+]]:gpr = LDAbs %stack.0 :: (load (s8) from %stack.0)
    ; STATIC-NEXT: [[LDAbs1:%[0-9]+]]:gpr = LDAbs %stack.0 + 1 :: (load (s8) from %stack.0 + 1)
    ; STATIC-NEXT: [[REG_SEQUENCE:%[0-9]+]]:imag16 = REG_SEQUENCE killed [[LDAbs]], %subreg.sublo, killed [[LDAbs1]], %subreg.subhi
    ; STATIC-NEXT: dead [[LDIndir:%[0-9]+]]:ac = LDIndir killed [[REG_SEQUENCE]]
    ; STATIC-NEXT: [[LDAbs2:%[0-9]+]]:gpr = LDAbs %stack.1 :: (load (s8) from %stack.1)
    ; STATIC-NEXT: [[LDAbs3:%[0-9]+]]:gpr = LDAbs %stack.1 + 1 :: (load (s8) from %stack.1 + 1)
    ; STATIC-NEXT: [[REG_SEQUENCE1:%[0-9]+]]:imag16 = REG_SEQUENCE killed [[LDAbs2]], %subreg.sublo, killed [[LDAbs3]], %subreg.subhi
    ; STATIC-NEXT: dead [[LDIndir1:%[0-9]+]]:ac = LDIndir killed [[REG_SEQUENCE1]]
    ; STATIC-NEXT: [[LDAbs4:%[0-9]+]]:gpr = LDAbs %stack.2 :: (load (s8) from %stack.2)
    ; STATIC-NEXT: [[LDAbs5:%[0-9]+]]:gpr = LDAbs %stack.2 + 1 :: (load (s8) from %stack.2 + 1)
    ; STATIC-NEXT: [[REG_SEQUENCE2:%[0-9]+]]:imag16 = REG_SEQUENCE killed [[LDAbs4]], %subreg.sublo, killed [[LDAbs5]], %subreg.subhi
    ; STATIC-NEXT: dead [[LDIndir2:%[0-9]+]]:ac = LDIndir killed [[REG_SEQUENCE2]]
    ; STATIC-NEXT: [[LDAbs6:%[0-9]+]]:gpr = LDAbs %stack.3 :: (load (s8) from %stack.3)
