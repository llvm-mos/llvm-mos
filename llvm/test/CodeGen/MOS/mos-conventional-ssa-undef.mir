# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mos -run-pass=mos-conventional-ssa -verify-machineinstrs %s -o - | FileCheck %s

# The dead definition's assignment must not constrain either instruction.
# Repeated undef inputs share a name within an instruction, but not between
# instructions. Physical undef operands retain their prescribed registers.
---
name: dead_definition
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: dead_definition
    ; CHECK: dead [[DEF:%[0-9]+]]:gpr = IMPLICIT_DEF
    ; CHECK-NEXT: [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
    ; CHECK-NEXT: INLINEASM &"", sideeffect attdialect, reguse:GPR, undef %2:gpr, reguse:GPR, undef %2:gpr, reguse:GPR, [[LDAbs]], reguse:GPR, undef $a
    ; CHECK-NEXT: INLINEASM &"", sideeffect attdialect, reguse:GPR, undef %3:gpr, reguse:GPR, killed [[LDAbs]]
    ; CHECK-NEXT: RTS
    dead %0:gpr = IMPLICIT_DEF
    %1:gpr = LDAbs 1000
    INLINEASM &"", sideeffect attdialect, reguse:GPR, undef %0, reguse:GPR, undef %0, reguse:GPR, %1, reguse:GPR, undef $a
    INLINEASM &"", sideeffect attdialect, reguse:GPR, undef %0, reguse:GPR, killed %1
    RTS
...

# Undef reads do not share the assignment of an ordinary read of the same
# register. The ordinary value and its liveness remain unchanged.
---
name: live_definition
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: live_definition
    ; CHECK: [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
    ; CHECK-NEXT: INLINEASM &"", sideeffect attdialect, reguse:GPR, undef %1:gpr, reguse:GPR, [[LDAbs]]
    ; CHECK-NEXT: STAbs killed [[LDAbs]], 2000
    ; CHECK-NEXT: RTS
    %0:gpr = LDAbs 1000
    INLINEASM &"", sideeffect attdialect, reguse:GPR, undef %0, reguse:GPR, %0
    STAbs killed %0, 2000
    RTS
...

# Undef-only virtual registers need no definition. Renaming preserves the
# register class and subregister views, including repeated reads of one lane.
---
name: subregisters_without_definition
tracksRegLiveness: true
registers:
  - { id: 0, class: imag16 }
body: |
  bb.0:
    ; CHECK-LABEL: name: subregisters_without_definition
    ; CHECK: INLINEASM &"", sideeffect attdialect, reguse:GPR, undef %1.sublo:imag16, reguse:GPR, undef %1.sublo:imag16, reguse:GPR, undef %1.subhi:imag16
    ; CHECK-NEXT: INLINEASM &"", sideeffect attdialect, reguse:GPR, undef %2.subhi:imag16
    ; CHECK-NEXT: RTS
    INLINEASM &"", sideeffect attdialect, reguse:GPR, undef %0.sublo, reguse:GPR, undef %0.sublo, reguse:GPR, undef %0.subhi
    INLINEASM &"", sideeffect attdialect, reguse:GPR, undef %0.subhi
    RTS
...
