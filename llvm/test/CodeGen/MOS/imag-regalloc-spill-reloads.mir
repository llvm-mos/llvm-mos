# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mos -mattr=+static-stack -stress-regalloc=8 -run-pass=mos-imag-reg-spill -verify-machineinstrs %s -o - | FileCheck %s

# Four return inputs must fit alongside transfer scratch. The intervening
# loads force multiple inputs to spill and subsequently reload together. Each
# reload must preserve both earlier results and the common scratch allowance.
--- |
  define void @reload_inputs() "nonreentrant" { ret void }
...
---
name: reload_inputs
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: reload_inputs
    ; CHECK: [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
    ; CHECK-NEXT: [[LDAbs1:%[0-9]+]]:gpr = LDAbs 1001
    ; CHECK-NEXT: [[LDAbs2:%[0-9]+]]:gpr = LDAbs 1002
    ; CHECK-NEXT: [[LDAbs3:%[0-9]+]]:gpr = LDAbs 1003
    ; CHECK-NEXT: [[LDAbs4:%[0-9]+]]:gpr = LDAbs 1004
    ; CHECK-NEXT: STAbs killed [[LDAbs]], %stack.0 :: (store (s8) into %stack.0)
    ; CHECK-NEXT: [[LDAbs5:%[0-9]+]]:gpr = LDAbs 1005
    ; CHECK-NEXT: STAbs killed [[LDAbs1]], %stack.1 :: (store (s8) into %stack.1)
    ; CHECK-NEXT: [[LDAbs6:%[0-9]+]]:gpr = LDAbs 1006
    ; CHECK-NEXT: STAbs killed [[LDAbs6]], 2002
    ; CHECK-NEXT: STAbs killed [[LDAbs4]], 2000
    ; CHECK-NEXT: STAbs killed [[LDAbs5]], 2001
    ; CHECK-NEXT: [[LDAbs7:%[0-9]+]]:gpr = LDAbs %stack.0 :: (load (s8) from %stack.0)
    ; CHECK-NEXT: [[LDAbs8:%[0-9]+]]:gpr = LDAbs %stack.1 :: (load (s8) from %stack.1)
    ; CHECK-NEXT: RTS implicit killed [[LDAbs7]], implicit killed [[LDAbs8]], implicit killed [[LDAbs2]], implicit killed [[LDAbs3]]
    %0:gpr = LDAbs 1000
    %1:gpr = LDAbs 1001
    %2:gpr = LDAbs 1002
    %3:gpr = LDAbs 1003
    %4:gpr = LDAbs 1004
    %5:gpr = LDAbs 1005
    %6:gpr = LDAbs 1006
    STAbs %6, 2002
    STAbs %4, 2000
    STAbs %5, 2001
    RTS implicit %0, implicit %1, implicit %2, implicit %3
...
