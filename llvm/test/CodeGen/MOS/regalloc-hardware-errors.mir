# RUN: split-file %s %t
# RUN: not llc -mtriple=mos -run-pass=mos-regalloc -verify-machineinstrs %t/multiple-blocks.mir -o /dev/null 2>&1 | FileCheck %s
# RUN: not llc -mtriple=mos -run-pass=mos-regalloc -verify-machineinstrs %t/loop.mir -o /dev/null 2>&1 | FileCheck %s
# RUN: not llc -mtriple=mos -run-pass=mos-regalloc -verify-machineinstrs %t/reg-sequence.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=REGSEQ

# CHECK: LLVM ERROR: MOSRegAlloc requires a single non-looping basic block

#--- multiple-blocks.mir
---
name: multiple_blocks
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    JMP %bb.1
  bb.1:
...

#--- loop.mir
---
name: loop
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.0
    JMP %bb.0
...

# REGSEQ: LLVM ERROR: MOSRegAlloc does not yet support REG_SEQUENCE

#--- reg-sequence.mir
---
name: reg_sequence
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr, assigned-phys: '$rc2' }
  - { id: 1, class: gpr, assigned-phys: '$rc3' }
  - { id: 2, class: imag16, assigned-phys: '$rs2' }
body: |
  bb.0:
    %0:gpr = LDImm 1
    %1:gpr = LDImm 2
    %2:imag16 = REG_SEQUENCE %0, %subreg.sublo, %1, %subreg.subhi
...
