# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mos -mcpu=mos65c02 -run-pass=mos-regalloc -verify-machineinstrs %s -o - | FileCheck %s

# Supply the imaginary assignments that precede hardware allocation. Checks
# cover the emitted physical operands and transfers; the machine verifier also
# checks that virtual registers have been eliminated and liveness is correct.

# A dead definition still needs a legal location. This is also a one-action
# solution, with no transfers or inputs.
---
name: dead_result
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr, assigned-phys: '$rc2' }
body: |
  bb.0:
    ; CHECK-LABEL: name: dead_result
    ; CHECK: dead $a = LDImm 42
    %0:gpr = LDImm 42
...

# Coalesce copies. Zero-cost instructions are still actions of the solution.
---
name: copy_chain
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr, assigned-phys: '$rc2' }
  - { id: 1, class: gpr, assigned-phys: '$rc3' }
  - { id: 2, class: gpr, assigned-phys: '$rc2' }
  - { id: 3, class: cc, assigned-phys: '$rc3lsb' }
body: |
  bb.0:
    ; CHECK-LABEL: name: copy_chain
    ; CHECK: $a = LDImm 1
    ; CHECK-NEXT: $a = COPY killed $a
    ; CHECK-NEXT: $a = COPY killed $a
    ; CHECK-NEXT: dead $c = CMPImm killed $a, 1
    %0:gpr = LDImm 1
    %1:gpr = COPY %0
    %2:gpr = COPY %1
    %3:cc = CMPImm %2, 1
...

# Simultaneously live values need distinct locations.
---
name: two_values
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr, assigned-phys: '$rc2' }
  - { id: 1, class: gpr, assigned-phys: '$rc3' }
  - { id: 2, class: cc, assigned-phys: '$rc4lsb' }
  - { id: 3, class: cc, assigned-phys: '$rc4lsb' }
body: |
  bb.0:
    ; CHECK-LABEL: name: two_values
    ; CHECK: $a = LDImm 1
    ; CHECK-NEXT: $x = LDImm 2
    ; CHECK-NEXT: dead $c = CMPImm killed $a, 1
    ; CHECK-NEXT: dead $c = CMPImm killed $x, 2
    %0:gpr = LDImm 1
    %1:gpr = LDImm 2
    %2:cc = CMPImm %0, 1
    %3:cc = CMPImm %1, 2
...

# Keep the live-in A pinned even when it has no SSA name in the allocation.
---
name: physical_live_in
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr, assigned-phys: '$rc2' }
  - { id: 1, class: cc, assigned-phys: '$rc3lsb' }
body: |
  bb.0:
    liveins: $a
    ; CHECK-LABEL: name: physical_live_in
    ; CHECK: liveins: $a
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $x = LDImm 7
    ; CHECK-NEXT: dead $c = CMPImm killed $x, 7
    ; CHECK-NEXT: RTS implicit killed $a
    %0:gpr = LDImm 7
    %1:cc = CMPImm %0, 7
    RTS implicit $a
...

# A physical definition stays live until its last use, even among the
# terminators.
---
name: physical_definition
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr, assigned-phys: '$rc2' }
body: |
  bb.0:
    ; CHECK-LABEL: name: physical_definition
    ; CHECK: $a = LDImm 7
    ; CHECK-NEXT: CmpZero killed $a, implicit-def $c
    ; CHECK-NEXT: RTS implicit killed $c
    %0:gpr = LDImm 7
    CmpZero %0, implicit-def $c
    RTS implicit $c
...

# A live physical subregister also prevents writes to its whole byte.
---
name: physical_subregister
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr, assigned-phys: '$rc2' }
  - { id: 1, class: cc, assigned-phys: '$rc3lsb' }
body: |
  bb.0:
    liveins: $alsb
    ; CHECK-LABEL: name: physical_subregister
    ; CHECK: liveins: $alsb
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $x = LDImm 7
    ; CHECK-NEXT: dead $c = CMPImm killed $x, 7
    ; CHECK-NEXT: RTS implicit killed $alsb
    %0:gpr = LDImm 7
    %1:cc = CMPImm %0, 7
    RTS implicit $alsb
...

# With all hardware bytes pinned, define and copy the value in imaginary
# registers.
---
name: imaginary_placement
tracksRegLiveness: true
registers:
  - { id: 0, class: anyi8, assigned-phys: '$rc2' }
  - { id: 1, class: anyi8, assigned-phys: '$rc3' }
body: |
  bb.0:
    liveins: $a, $x, $y
    ; CHECK-LABEL: name: imaginary_placement
    ; CHECK: liveins: $a, $x, $y
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $rc2 = IMPLICIT_DEF
    ; CHECK-NEXT: dead $rc3 = COPY killed $rc2
    ; CHECK-NEXT: RTS implicit killed $a, implicit killed $x, implicit killed $y
    %0:anyi8 = IMPLICIT_DEF
    %1:anyi8 = COPY %0
    RTS implicit $a, implicit $x, implicit $y
...

# An early-clobber definition cannot reuse a killed input's location.
---
name: early_clobber
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr, assigned-phys: '$rc2' }
  - { id: 1, class: gpr, assigned-phys: '$rc3' }
  - { id: 2, class: cc, assigned-phys: '$rc4lsb' }
body: |
  bb.0:
    ; CHECK-LABEL: name: early_clobber
    ; CHECK: $a = LDImm 1
    ; CHECK-NEXT: early-clobber $x = COPY killed $a
    ; CHECK-NEXT: dead $c = CMPImm killed $x, 1
    %0:gpr = LDImm 1
    early-clobber %1:gpr = COPY %0
    %2:cc = CMPImm %1, 1
...

# Apply a byte's subregister selection exactly once when choosing the use.
---
name: byte_to_flag
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr, assigned-phys: '$rc2' }
  - { id: 1, class: cc, assigned-phys: '$rc3lsb' }
body: |
  bb.0:
    ; CHECK-LABEL: name: byte_to_flag
    ; CHECK: $a = LDImm 1
    ; CHECK-NEXT: dead $alsb = COPY killed $alsb
    %0:gpr = LDImm 1
    %1:cc = COPY %0.sublsb
...

# A pair cannot fit in one hardware register. Its projected uses read the
# corresponding bytes of the imaginary assignment.
---
name: pair_projections
tracksRegLiveness: true
registers:
  - { id: 0, class: imag16, assigned-phys: '$rs4' }
  - { id: 1, class: gpr, assigned-phys: '$rc2' }
  - { id: 2, class: gpr, assigned-phys: '$rc3' }
  - { id: 3, class: cc, assigned-phys: '$rc4lsb' }
  - { id: 4, class: cc, assigned-phys: '$rc4lsb' }
body: |
  bb.0:
    ; CHECK-LABEL: name: pair_projections
    ; CHECK: $rs4 = IMPLICIT_DEF
    ; CHECK-NEXT: $a = COPY killed $rc8
    ; CHECK-NEXT: $x = COPY killed $rc9
    ; CHECK-NEXT: dead $c = CMPImm killed $a, 1
    ; CHECK-NEXT: dead $c = CMPImm killed $x, 2
    %0:imag16 = IMPLICIT_DEF
    %1:gpr = COPY %0.sublo
    %2:gpr = COPY %0.subhi
    %3:cc = CMPImm %1, 1
    %4:cc = CMPImm %2, 2
...

# A flag can remain in C; copying it must not turn it into a full-byte value
# or lose the selected flag source.
---
name: carry_value
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr, assigned-phys: '$rc2' }
  - { id: 1, class: cc, assigned-phys: '$rc3lsb' }
  - { id: 2, class: anyi1, assigned-phys: '$rc4lsb' }
body: |
  bb.0:
    ; CHECK-LABEL: name: carry_value
    ; CHECK: $a = LDImm 1
    ; CHECK-NEXT: $c = CMPImm killed $a, 2
    ; CHECK-NEXT: dead $c = COPY killed $c
    %0:gpr = LDImm 1
    %1:cc = CMPImm %0, 2
    %2:anyi1 = COPY %1
...

# V is a separate hardware location from C. Physical flag operands remain
# pinned until their last use, just like physical byte registers.
---
name: overflow_value
tracksRegLiveness: true
registers:
  - { id: 0, class: vc, assigned-phys: '$rc2lsb' }
  - { id: 1, class: anyi1, assigned-phys: '$rc3lsb' }
body: |
  bb.0:
    liveins: $c
    ; CHECK-LABEL: name: overflow_value
    ; CHECK: liveins: $c
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $v = CLV
    ; CHECK-NEXT: dead $v = COPY killed $v
    ; CHECK-NEXT: RTS implicit killed $c
    %0:vc = CLV
    %1:anyi1 = COPY %0
    RTS implicit $c
...

# An empty solution has no actions.
---
name: empty
tracksRegLiveness: true
body: |
  bb.0:
...
